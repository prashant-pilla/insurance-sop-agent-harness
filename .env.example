# Copy to .env and fill in LLM_API_KEY. Everything else has a working default.

# Provider: "openai" (OpenAI or any OpenAI-compatible chat-completions host) or "anthropic".
LLM_PROVIDER=openai

# Required. The only value you must set.
LLM_API_KEY=sk-your-key-here

# Optional. Defaults: gpt-4o-mini (openai) / claude-haiku-4-5-20251001 (anthropic).
# If your provider returns HTTP 404 the default model has been retired; set a current one here.
# LLM_MODEL=gpt-4o-mini

# Optional. Defaults: https://api.openai.com/v1 (openai) / https://api.anthropic.com (anthropic).
# For OpenAI-compatible hosts point this at the base that precedes /chat/completions, e.g.
#   OpenRouter: https://openrouter.ai/api/v1
#   vLLM:       http://localhost:8001/v1
#   Ollama:     http://localhost:11434/v1
#   Azure:      an OpenAI-compatible gateway in front of Azure OpenAI (the raw Azure endpoint needs api-version/api-key)
# LLM_BASE_URL=https://api.openai.com/v1

# SOP thresholds (integers). Reaching any of them offers or triggers a human handoff.
# MAX_VERIFY_ATTEMPTS: identity attempts with a mismatch before a human is offered; one further
#   mismatching attempt transfers automatically.
# MAX_OFF_TOPIC: consecutive off-topic turns before HUMAN_HANDOFF.
# MAX_FRUSTRATION_TURNS: consecutive frustrated turns without progress before HUMAN_HANDOFF.
MAX_VERIFY_ATTEMPTS=3
MAX_OFF_TOPIC=3
MAX_FRUSTRATION_TURNS=3

# Per-turn debug trace: returned as "debug" in the API response, shown in the UI "Turn debug" panel,
# and appended to traces/<session_id>.jsonl. Identity values in the extraction are masked, but the
# trace still names the caller and their case hints. Default is true (demo setting); set to false
# for anything beyond a local demo.
TRACE_ENABLED=true
